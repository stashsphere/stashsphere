{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Depth",
  "description": "Front-to-back extent of an object",
  "type": "object",
  "properties": {
    "name": {
      "const": "depth"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "mm",
        "cm",
        "m",
        "km",
        "in",
        "ft"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-icons": [
    "mdi:arrow-expand-down"
  ]
}
