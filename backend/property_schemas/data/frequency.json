{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frequency",
  "description": "Operating or signal frequency",
  "type": "object",
  "properties": {
    "name": {
      "const": "frequency"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "Hz",
        "kHz",
        "MHz",
        "GHz"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-aliases": [
    "freq"
  ],
  "x-icons": [
    "mdi:sine-wave"
  ]
}
