{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Volume Capacity",
  "description": "Liquid or spatial volume a container holds",
  "type": "object",
  "properties": {
    "name": {
      "const": "volume_capacity"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "mL",
        "cL",
        "L",
        "cm³",
        "dm³",
        "m³"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-aliases": [
    "volume",
    "vol"
  ],
  "x-icons": [
    "mdi:cup-water"
  ]
}
