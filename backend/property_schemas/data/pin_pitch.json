{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pin Pitch",
  "description": "Spacing between component pins or leads",
  "type": "object",
  "properties": {
    "name": {
      "const": "pin_pitch"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "mm",
        "in"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-icons": [
    "mdi:pin"
  ]
}
