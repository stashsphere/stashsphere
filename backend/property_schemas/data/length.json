{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Length",
  "description": "Physical length or distance measurement",
  "type": "object",
  "properties": {
    "name": {
      "const": "length"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "mm",
        "cm",
        "m",
        "km",
        "in",
        "ft"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-aliases": [
    "len",
    "l"
  ],
  "x-icons": [
    "mdi:ruler"
  ]
}
