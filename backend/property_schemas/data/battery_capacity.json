{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battery Capacity",
  "description": "Charge or energy a battery can store",
  "type": "object",
  "properties": {
    "name": {
      "const": "battery_capacity"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "mAh",
        "Ah",
        "Wh"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-aliases": [
    "bat_capacity",
    "battery_cap"
  ],
  "x-icons": [
    "mdi:battery"
  ]
}
