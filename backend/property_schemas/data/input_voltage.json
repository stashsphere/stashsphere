{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Input Voltage",
  "description": "Electrical voltage accepted at the input",
  "type": "object",
  "properties": {
    "name": {
      "const": "input_voltage"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "V",
        "mV",
        "kV"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-aliases": [
    "v_in"
  ],
  "x-icons": [
    "mdi:login-variant"
  ]
}
