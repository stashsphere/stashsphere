{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weight",
  "description": "Mass of an item",
  "type": "object",
  "properties": {
    "name": {
      "const": "weight"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "mg",
        "g",
        "kg",
        "lb",
        "oz"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-icons": [
    "mdi:weight"
  ]
}
