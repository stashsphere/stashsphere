{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rated Power",
  "description": "Nominal power rating under standard conditions",
  "type": "object",
  "properties": {
    "name": {
      "const": "rated_power"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "enum": [
        "W",
        "mW",
        "kW"
      ]
    }
  },
  "required": [
    "name",
    "value",
    "unit"
  ],
  "additionalProperties": false,
  "x-aliases": [
    "p_rated",
    "nominal_power"
  ],
  "x-icons": [
    "mdi:flash"
  ]
}
