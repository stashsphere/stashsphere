{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stashsphere.com/schemas/root/datetime",
  "title": "Meta-schema for DateTime Schemas",
  "description": "Validates JSON schemas for datetime values",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "type": {
      "type": "string",
      "const": "object"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "$id": {
      "type": "string"
    },
    "properties": {
      "type": "object",
      "properties": {
        "name": {
          "type": "object",
          "properties": {
            "const": { "type": "string" }
          },
          "required": ["const"]
        },
        "value": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "const": "string" },
            "format": { "type": "string", "const": "date-time" }
          },
          "required": ["type", "format"]
        }
      },
      "required": ["name", "value"],
      "additionalProperties": false
    },
    "required": {
      "type": "array",
      "const": ["name", "value"]
    },
    "additionalProperties": {
      "type": "boolean",
      "const": false
    },
    "x-aliases": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "x-icons": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "required": ["$schema", "type", "properties", "required", "additionalProperties"],
  "additionalProperties": false
}
